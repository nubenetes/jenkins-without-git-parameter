# ==============================================================================
# Enterprise GitOps Platform: Environment & Endpoint Configurations
# Architecture: GitOps Pull Model (ArgoCD 3.5 + Jenkins Multibranch CI)
# ==============================================================================

PLATFORM_DOMAIN="apps.ocp-dev.nubenetes.internal"
PLATFORM_NAMESPACE_JENKINS="jenkins"
PLATFORM_NAMESPACE_ARGOCD="argocd"
PLATFORM_NAMESPACE_OBSERVABILITY="observability"

# Workload Namespaces
NAMESPACE_DEV="nubenetes-dev-apps"
NAMESPACE_STAGING="nubenetes-staging-apps"
NAMESPACE_PROD="nubenetes-prod-apps"

# Git Repositories
GITOPS_REPO_URL="https://github.com/nubenetes/jenkins-without-git-parameter.git"
APP_JAVA_REPO_URL="https://github.com/nubenetes/jenkins-without-git-parameter.git"
APP_ANGULAR_REPO_URL="https://github.com/nubenetes/angular-frontend.git"

# OpenShift Container Registries
DEV_REGISTRY="image-registry.openshift-image-registry.svc:5000/nubenetes-dev-apps"
STAGING_REGISTRY="image-registry.openshift-image-registry.svc:5000/nubenetes-staging-apps"
PROD_REGISTRY="image-registry.openshift-image-registry.svc:5000/nubenetes-prod-apps"

# ArgoCD 3.5 Endpoints
ARGOCD_SERVER_URL="https://argocd-server.apps.ocp-dev.nubenetes.internal"
ARGOCD_SERVER_GRPC="argocd-server.argocd.svc.cluster.local:443"

# Observability (OpenTelemetry, Prometheus, Grafana 13.2.0)
OTEL_COLLECTOR_URL="http://otel-collector.observability.svc.cluster.local:4317"
PROMETHEUS_URL="http://prometheus-k8s.observability.svc.cluster.local:9090"
GRAFANA_URL="https://grafana.apps.ocp-dev.nubenetes.internal"
