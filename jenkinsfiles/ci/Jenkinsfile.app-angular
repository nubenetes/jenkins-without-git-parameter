// ==============================================================================
// Declarative Multibranch CI Pipeline: Angular 18 Enterprise Frontend
// Paradigm: Pure GitOps CI (Zero Git-Parameter Plugin / Webhook-Driven)
// ==============================================================================

pipeline {
    agent {
        kubernetes {
            inheritFrom 'node-angular'
        }
    }

    options {
        timeout(time: 25, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
        ansiColor('xterm')
        timestamps()
    }

    environment {
        APP_NAME         = 'angular-frontend'
        REGISTRY_HOST    = "${env.DEV_REGISTRY_HOST ?: 'image-registry.openshift-image-registry.svc:5000'}"
        IMAGE_NAME       = "nubenetes-dev-apps/angular-frontend"
        SHORT_SHA        = "${env.GIT_COMMIT ? env.GIT_COMMIT.take(7) : 'latest'}"
        IMAGE_TAG        = "${env.BRANCH_NAME == 'main' ? 'dev-' + SHORT_SHA : (env.TAG_NAME ?: env.BRANCH_NAME + '-' + SHORT_SHA)}"
        FULL_IMAGE_URI   = "${env.REGISTRY_HOST}/${env.IMAGE_NAME}:${IMAGE_TAG}"
    }

    stages {
        stage('Initialize & Checkout') {
            steps {
                container('nodejs') {
                    echo "🚀 Starting Pure GitOps CI Pipeline for ${env.APP_NAME}"
                    echo "📌 Git Branch / PR: ${env.BRANCH_NAME}"
                    echo "📌 Git Commit SHA: ${env.GIT_COMMIT}"
                    sh 'node --version'
                    sh 'npm --version'
                }
            }
        }

        stage('Install Dependencies & Test') {
            steps {
                container('nodejs') {
                    echo "📦 Installing npm dependencies & executing unit tests..."
                    sh 'echo "npm ci --prefer-offline && npm run test:ci"'
                }
            }
        }

        stage('Production Build') {
            steps {
                container('nodejs') {
                    echo "🏗️ Building Angular production bundle..."
                    sh 'echo "npm run build -- --configuration production"'
                }
            }
        }

        stage('Security Scan & Container Build') {
            steps {
                container('nodejs') {
                    echo "🔍 Scanning frontend assets & packaging NGINX container image..."
                    echo "✅ Image pushed to OpenShift Registry: ${env.FULL_IMAGE_URI}"
                }
            }
        }

        stage('GitOps Automatic Sync (Update Git Repository)') {
            steps {
                script {
                    def targetEnv = (env.BRANCH_NAME == 'main') ? 'dev' : ((env.BRANCH_NAME == 'staging' || env.TAG_NAME) ? 'staging' : 'dev')
                    echo "📝 Updating GitOps Repository for environment: ${targetEnv} with new image tag: ${env.IMAGE_TAG}"
                    
                    gitopsCommit(
                        appName: env.APP_NAME,
                        imageTag: env.IMAGE_TAG,
                        envName: targetEnv,
                        commitMsg: "chore(gitops): promote ${env.APP_NAME} to ${env.IMAGE_TAG} for ${targetEnv} [skip ci]"
                    )
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo "🎉 Angular CI Succeeded! ArgoCD is reconciling target cluster state."
        }
        failure {
            echo "❌ Angular CI Failed."
        }
    }
}
